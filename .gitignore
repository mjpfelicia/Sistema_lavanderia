```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db
```